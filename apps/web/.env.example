# Central Better Auth app (shared across *.sezaba.de consumers)
NEXT_PUBLIC_AUTH_URL=https://auth.sezaba.de
AUTH_URL=https://auth.sezaba.de

# Local dev: point at your running auth app (getSession returns null if it is down)
# NEXT_PUBLIC_AUTH_URL=http://localhost:8000
# AUTH_URL=http://localhost:8000

# Must match the auth server secret when decoding cookies locally (optional for getSession)
# BETTER_AUTH_SECRET=

# Neon Postgres (Drizzle) — see packages/db/README.md
# DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require"
