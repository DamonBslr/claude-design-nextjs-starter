# Better Auth is hosted by this Next.js app at /api/auth/*.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Neon Postgres (Drizzle) — see packages/db/README.md
DATABASE_URL=

# Transactional organization invitation email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Next Starter <invites@example.com>"
